{
  "name": "nzxt",
  "version": "0.4.0",
  "main": "dst/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./dst/index.d.ts",
      "default": "./dst/index.js"
    },
    "./h": {
      "types": "./dst/h.d.ts",
      "default": "./dst/h.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "bin/nzxt.js",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.28.2",
    "esbuild-register": "^3.6.0",
    "source-map-support": "^0.5.21",
    "summer-framework": "^0.3.0",
    "ts-jest": "^29.4.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zheleznaya": "^0.3.4"
  },
  "scripts": {
    "start": "ts-node --project tsconfig.app.json --files bin/nzxt.js",
    "build": "tsc --project tsconfig.json",
    "prepublish": "yarn build"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+.tsx?$": [
        "ts-jest",
        {}
      ],
      "node_modules/zheleznaya/.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.deno/zheleznaya@[^/]+/node_modules/)?zheleznaya/)"
    ]
  }
}
